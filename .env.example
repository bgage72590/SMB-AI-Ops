# ============================================================
# SMB AI Ops — Environment Configuration
# ============================================================
# Copy this file to .env and fill in the values you need.
# Only ANTHROPIC_API_KEY is required. Everything else enables
# optional features and can be added later.
# ============================================================

# ============================================================
# REQUIRED — AI
# ============================================================

# Get your key at https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-...

# Optional: override the model (defaults to claude-sonnet-4-20250514)
# ANTHROPIC_MODEL=claude-sonnet-4-20250514

# ============================================================
# APP URL
# ============================================================

# Your app's public URL. Used for password reset links, OAuth
# redirects, and the embeddable chat widget.
# In local dev: http://localhost:3000
# In production: https://app.yourdomain.com
APP_BASE_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ============================================================
# EMAIL — SendGrid (optional)
# ============================================================
# Enables real email sending and inbound email processing.
# Without these the app still runs — sending falls back to
# "Mark sent" and inbound email must be posted via API.
# Sign up at https://sendgrid.com

SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=you@yourdomain.com

# Secret for the SendGrid Inbound Parse webhook. Append
# ?token=<value> to the webhook URL.
SENDGRID_INBOUND_SECRET=

# Optional: ECDSA public key for SendGrid signed event webhooks.
# SENDGRID_WEBHOOK_VERIFICATION_KEY=

# Domain for per-user inbound email addresses (e.g. inbound.smbaiops.com)
# In local dev defaults to inbound.local
INBOUND_ADDRESS_DOMAIN=inbound.local

# ============================================================
# SMS — Twilio (optional)
# ============================================================
# Enables SMS follow-ups. Only contacts with a phone number can
# receive SMS. Sign up at https://twilio.com

TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# ============================================================
# BILLING — Stripe (optional)
# ============================================================
# Enables subscription billing. Get keys at https://dashboard.stripe.com/apikeys
# Create products/prices in Stripe and paste the price IDs below.

STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_STARTER_PRICE_ID=
STRIPE_PRO_PRICE_ID=
NEXT_PUBLIC_STRIPE_STARTER_PRICE_ID=
NEXT_PUBLIC_STRIPE_PRO_PRICE_ID=

# ============================================================
# CALENDAR — Google (optional)
# ============================================================
# Enables calendar-aware scheduling. When connected, the AI reads
# free/busy to propose specific appointment times.
# Set up at https://console.cloud.google.com/apis/credentials

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ============================================================
# SCHEDULING LINK (optional)
# ============================================================
# A self-serve booking URL (Cal.com, Calendly, etc.). The AI
# includes it in follow-up replies about scheduling.
# Example: https://cal.com/your-handle/intro

SCHEDULING_LINK=

# ============================================================
# DATABASE (optional)
# ============================================================
# Defaults to SQLite at ./data/store.sqlite. To use Postgres:
#   DB_BACKEND=postgres
#   DATABASE_URL=postgres://user:pass@host:5432/dbname

DB_BACKEND=sqlite
DATABASE_URL=

# ============================================================
# NOTIFICATIONS — Slack (optional)
# ============================================================
# Sends alerts to a Slack channel. Create an incoming webhook at
# https://api.slack.com/messaging/webhooks

SLACK_WEBHOOK_URL=
SLACK_SIGNING_SECRET=

# ============================================================
# LEAD ENRICHMENT (optional)
# ============================================================
# Point at Clearbit, Apollo, People Data Labs, or your own proxy.
# Must accept GET ?email=<email> and return JSON.

ENRICHMENT_API_URL=
ENRICHMENT_API_KEY=

# ============================================================
# CRON / BACKGROUND JOBS (optional)
# ============================================================
# Secret for cron endpoints. Set in production to prevent
# unauthenticated triggers.

CRON_SECRET=

# ============================================================
# BACKUPS — S3 (optional)
# ============================================================
# S3-compatible bucket for nightly SQLite backups.

BACKUP_S3_BUCKET=
BACKUP_S3_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# ============================================================
# CHAT WIDGET (optional)
# ============================================================
# Random string to sign widget tokens. Only needed if you embed
# the lead capture widget on your website.

WIDGET_SECRET=
