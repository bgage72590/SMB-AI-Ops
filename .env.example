# Anthropic API key (get one at https://console.anthropic.com)
ANTHROPIC_API_KEY=sk-ant-...

# Optional: override the model. Defaults to claude-opus-4-6.
ANTHROPIC_MODEL=claude-opus-4-6

# --- Postmark (optional) ---
# Needed to receive real email via inbound webhook and to send follow-ups.
# Without these the app still runs; sending falls back to "Mark sent" and
# inbound email must be ingested via POST /api/inbox directly.
POSTMARK_SERVER_TOKEN=
POSTMARK_FROM_EMAIL=you@yourdomain.com

# Shared secret for the Postmark inbound webhook. Append ?token=<value> to
# the webhook URL, or use Basic Auth with this as the password.
POSTMARK_INBOUND_SECRET=

# Preferred: HMAC-SHA256 secret for the inbound webhook. When set, the
# request MUST include an `X-Signature: sha256=<hex>` header computed over
# the raw request body, and the shared-secret check is skipped. The secret
# never travels over the wire.
POSTMARK_WEBHOOK_HMAC_SECRET=

# --- Inbound address domain ---
# The domain used to mint per-user inbound email addresses on signup. Each
# user gets an address like `<slug>-<hex>@<this-domain>`. In production this
# should be a subdomain you've set up as a Postmark inbound stream (e.g.
# inbound.smbaiops.com). In local dev it defaults to `inbound.local` so
# signup still works without any MX setup.
INBOUND_ADDRESS_DOMAIN=inbound.local

# --- Scheduling (optional) ---
# A self-serve scheduling URL (Cal.com, Calendly, SavvyCal — whatever you
# use). When set, the AI follow-up drafter will include it in replies that
# are about booking a call, demo, or intro so the owner doesn't have to
# paste it by hand. Leave blank to have the AI just offer to send times.
# Example: https://cal.com/your-handle/intro
SCHEDULING_LINK=

# --- Twilio (optional) ---
# Enables SMS follow-ups. Only contacts with a phone number on file can
# receive SMS. Without these the app still works — just email-only.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# --- Google Calendar (optional) ---
# Enables calendar-aware scheduling replies. When connected, the AI reads
# the owner's free/busy schedule to propose specific appointment times.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Database (optional) ---
# By default the app uses SQLite stored in ./data/store.sqlite.
# To use Postgres instead, set both of these:
#   DB_BACKEND=postgres
#   DATABASE_URL=postgres://user:pass@host:5432/dbname
# The Postgres schema is migrated automatically on boot.
DB_BACKEND=sqlite
DATABASE_URL=

# --- Cron (optional) ---
# Shared secret for cron endpoints (/api/jobs/deal-decay, /api/jobs/weekly-digest).
# In production, set this to prevent unauthenticated triggers.
CRON_SECRET=

# --- Backups (optional) ---
# S3-compatible bucket for nightly SQLite backups.
BACKUP_S3_BUCKET=
BACKUP_S3_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
