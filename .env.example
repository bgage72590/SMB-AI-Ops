# Anthropic API key (get one at https://console.anthropic.com)
ANTHROPIC_API_KEY=sk-ant-...

# Optional: override the model. Defaults to claude-opus-4-6.
ANTHROPIC_MODEL=claude-opus-4-6

# --- Postmark (optional) ---
# Needed to receive real email via inbound webhook and to send follow-ups.
# Without these the app still runs; sending falls back to "Mark sent" and
# inbound email must be ingested via POST /api/inbox directly.
POSTMARK_SERVER_TOKEN=
POSTMARK_FROM_EMAIL=you@yourdomain.com

# Shared secret for the Postmark inbound webhook. Append ?token=<value> to
# the webhook URL, or use Basic Auth with this as the password.
POSTMARK_INBOUND_SECRET=

# Preferred: HMAC-SHA256 secret for the inbound webhook. When set, the
# request MUST include an `X-Signature: sha256=<hex>` header computed over
# the raw request body, and the shared-secret check is skipped. The secret
# never travels over the wire.
POSTMARK_WEBHOOK_HMAC_SECRET=
